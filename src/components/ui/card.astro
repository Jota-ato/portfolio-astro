---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'article'> {
  className?: string;
}

const { className = "" } = Astro.props as Props;

---

<article
  class={`bg-surface p-4 rounded-md border border-muted flex flex-col gap-4 ${className}`}
  {...Astro.props}
>
  <slot name="header" />
  <slot name="content" />
  <slot name="footer" />
</article>
