---
import Container from "../layout/container.astro"
---

<section id="hero" class="bg-secondary text-secondary-foreground py-8 md:py-12">
    <Container className="flex justify-center items-center">
        <div class="flex flex-1 justify-between gap-8">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold">
                    Full-stack web developer
                </h1>
                <h2 class="text-xl text-primary font-medium mb-4">Julio Zavala</h2>
                <p class="max-w-md">
                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Necessitatibus atque sunt eveniet fuga eius minima labore nobis sint magni mollitia animi, itaque unde libero non sed incidunt aut deserunt eligendi.
                </p>
            </div>

            <div>
                <img
                    src="/public/img/me.jpeg"
                    alt="Julio Zavala"
                    
                />
            </div>
        </div>
    </Container>
</section>