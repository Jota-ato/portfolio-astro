---
import Container from "../layout/container.astro";
---

<section id="hero" class="py-8 md:py-12 mt-20 md:mt-30">
  <Container className="flex justify-center items-center">
    <div class="flex flex-1 justify-between gap-3">
      <div>
        <h1 class="text-[80px]">Custom Software</h1>
        <h2 class="text-base text-accent mb-4">
          Julio Zavala - Full Stack Dev
        </h2>
        <p class="max-w-lg">
          I build high-performance web systems, boost your productivity, and
          streamline your operations. Zero generic templates. Just tailored
          software engineered to optimize your operations.
        </p>
      </div>
    </div>
  </Container>
</section>
