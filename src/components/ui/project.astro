---
const { class: className, ...rest } = Astro.props
---

<article class={`flex flex-col md:flex-row gap-8 ${className || ''}`}  {...rest}>
  <div class="shrink-0 [&>img]:rounded-md [&>img]:aspect-video">
    <slot name="image" />
  </div>
  <div class="flex-1 flex flex-col gap-4">
    <slot name="header" />
    <slot name="body" />
  </div>
</article>
