---
import type { HTMLAttributes } from 'astro/types';


type Variants = "primary" | "secondary";
interface Props extends HTMLAttributes<'button'> {
  className?: string;
  variant?: Variants;
} 

const { className, variant = "primary", ...rest } = Astro.props;

const classesMap: Record<Variants, string> = {
  primary: "bg-primary text-background hover:bg-primary/80",
  secondary:
    "bg-background text-secondary border border-secondary hover:bg-secondary/80",
};
---

<button
  class={`${classesMap[variant]} rounded-md px-3 py-1 transition-colors duration-200 ${className}`}
  {...rest}
>
  <slot />
</button>
