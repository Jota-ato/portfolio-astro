---
import { Image } from "astro:assets";
import Container from "../layout/container.astro";
import HeroText from "../ui/hero-text.astro";
---

<section id="hero" class="py-8 md:py-12 sm:mt-16">
  <Container className="flex justify-center items-center">
    <div class="flex flex-col flex-1 md:flex-row min-w-0">
      <HeroText />
      <div class="flex justify-start items-start min-w-0">
        <div class="relative group">
          <Image
            width={300}
            height={300}
            src="/img/me.webp"
            class="relative z-10 rounded-full object-cover size-64 hidden md:block ring-4 ring-white/10"
            alt="Julio Zavala"
            loading="eager"
          />
          <div
            class="absolute inset-0 -z-10 rounded-full bg-primary/30 blur-[60px] scale-115"
            aria-hidden="true"
          >
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
