---
import Container from "../layout/container.astro";
import Button from "../ui/button.astro";
import Github from "../icons/github.astro";
import Mail from "../icons/mail.astro";
---

<section id="hero" class="py-8 md:py-12 sm:mt-24">
  <Container className="flex justify-center items-center">
    <div class="flex flex-col flex-1 md:flex-row">
      <div class="flex flex-1 flex-col">
        <img
          src="/img/me.jpeg"
          class="rounded-full object-cover size-32 md:hidden mb-4"
          alt="Julio Zavala"
        />
        <h1 class="text-[60px] md:text-[80px]">Custom Software</h1>
        <h2 class="text-base text-accent">Julio Zavala - Full Stack Dev</h2>
        <p class="mt-8">
          I build high-performance web systems, boost your productivity, and
          streamline your operations. Zero generic templates. Just tailored
          software engineered to optimize your operations.
        </p>
        <div class="flex flex-col md:flex-row items-left md:items-center gap-4 mt-4">
          <Button>See my work</Button>
          <nav class="flex gap-4 items-center">
            <a
              href="https://github.com/Jota-ato"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors duration-300"
              aria-label="GitHub link"
            >
              <Github />
            </a>
            <a
              href="mailto:juliozavala@julio-zavala.me"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors duration-300"
              aria-label="Mail link"
            >
              <Mail />
            </a>
          </nav>
        </div>
      </div>
      <div class="flex justify-start">
        <img
          src="/img/me.jpeg"
          class="rounded-full object-cover size-64 hidden md:block"
          alt="Julio Zavala"
        />
      </div>
    </div>
  </Container>
</section>
