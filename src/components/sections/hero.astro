---
import Container from "../layout/container.astro";
import Button from "../ui/button.astro";
import Github from "../icons/github.astro";
import Mail from "../icons/mail.astro";
---

<section id="hero" class="py-8 md:py-12 sm:mt-16">
  <Container className="flex justify-center items-center">
    <div class="flex flex-col flex-1 md:flex-row">
      <div class="flex flex-1 flex-col">
        <img
          src="/img/me.webp"
          class="rounded-full object-cover size-32 md:hidden mb-4"
          alt="Julio Zavala"
        />
        <h1 class="text-[48px] md:text-[60px]">
          Custom Web Apps Engineered to Scale Your Business
        </h1>
        <h2 class="text-base text-accent">
          Julio Zavala — Full Stack Developer
        </h2>
        <p class="mt-8">
          I build high-performance web applications and internal tools that
          streamline business operations. Zero generic templates—just tailored,
          scalable software built to solve your specific problems.
        </p>
        <div
          class="flex flex-col md:flex-row items-left md:items-center gap-4 mt-4"
        >
          <nav class="flex flex-col items-start sm:flex-row gap-4 sm:items-center">
            <a
              class="bg-primary text-background hover:bg-primary/80 rounded-md px-3 py-1 transition-colors duration-200 cursor-pointer"
              href="mailto:juliozavala@julio-zavala.me"
              target="_blank"
              rel="noopener noreferrer">Let's Talk About Your Project</a
            >
            <a href="#projects" class="bg-background text-secondary border border-secondary hover:bg-secondary/80 rounded-md px-3 py-1 transition-colors duration-200">
              See my work
            </a>
            <a
              href="https://github.com/Jota-ato"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary transition-colors duration-300"
              aria-label="GitHub link"
            >
              <Github />
            </a>
          </nav>
        </div>
      </div>
      <div class="flex justify-start">
        <img
          src="/img/me.webp"
          class="rounded-full object-cover size-64 hidden md:block"
          alt="Julio Zavala"
        />
      </div>
    </div>
  </Container>
</section>
