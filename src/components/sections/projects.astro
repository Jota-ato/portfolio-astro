---
import Section from "../layout/section.astro";
import Container from "../layout/container.astro";
import Project from "@/components/ui/project.astro";
import ExternalLink from "@/components/icons/external-link.astro";
import Github from "@/components/icons/github.astro";
---

<Section id="projects">
  <Container className="space-y-10">
    <h2>Projects</h2>
    <Project>
      <img slot="image" src="/img/manita-de-gato.png" alt="project-1" />

      <header slot="header">
        <h3>Manita de Gato</h3>
      </header>
      <main slot="body" class="flex flex-col gap-4">
        <div>
          <span class="rounded-md px-2 py-1 border border-primary text-primary text-xs">
            Next.js
          </span>
        </div>
        <p class="text-sm text-muted">
          A custom booking engine and dashboard that eliminates manual
          scheduling conflicts. It gives business owners complete control over
          services and pricing with zero recurring platform fees.
        </p>
        <nav class="flex items-center gap-4">
          <a
            class="flex gap-2 items-center border border-secondary text-secondary rounded-md px-2 py-1 text-sm cursor-pointer hover:bg-secondary hover:text-background transition-colors duration-300"
            href="https://booking-system-flame-eight.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <ExternalLink class="size-4" />
            See live
          </a>
          <a
            class="flex gap-2 items-center border border-foreground text-foreground rounded-md px-2 py-1 text-sm cursor-pointer hover:bg-foreground hover:text-background transition-colors duration-300"
            href="https://github.com/Jota-ato/manita-de-gato-portfolio"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Github class="size-4" />
            Code
          </a>
        </nav>
      </main>
    </Project>
  </Container>
</Section>
