---
import Section from "../layout/section.astro";
import Container from "../layout/container.astro";
import { Image } from "astro:assets";
---

<Section id="me" class="bg-secondary">
  <Container
    className="space-y-4 flex flex-col-reverse md:flex-row gap-8 items-center font-mono"
  >
    <div class="space-y-4">
      <h2
        aria-label="About me"
        id="about-title"
        class="text-background text-3xl font-bold mb-6 font-mono h-16"
      >
      </h2>

      <p class="text-background leading-relaxed">
        Hi, I'm <strong
          class="bg-background/90 text-secondary px-1.5 py-0.5 rounded"
          >Julio Zavala</strong
        >. My passion for programming began years ago during high school when I
        wrote my first lines of C++ and web code. What started as deep curiosity
        quickly grew into years of dedicated engineering, mastering modern
        full-stack development.
      </p>

      <p class="text-background/90 leading-relaxed">
        With over 3 years of hands-on experience building web applications, I
        specialize in creating <strong
          class="bg-background/90 text-secondary px-1.5 py-0.5 rounded"
          >fast booking engines, internal dashboards, and high-converting
          layouts</strong
        > using tools like Next.js, Astro, and modern databases.
      </p>

      <p class="text-background/90 leading-relaxed">
        My mission is simple: to help independent businesses eliminate
        operational friction, replace overpriced monthly software subscriptions,
        and deliver seamless digital experiences to their clients.
      </p>
    </div>
    <div class="flex justify-center">
      <div
        class="relative w-64 h-64 rounded-2xl overflow-hidden border-2 border-accent/20 shadow-xl rotate-5"
      >
        <Image
          width={300}
          height={300}
          src="/img/me-about.webp"
          alt="Julio Zavala"
          class="size-full object-cover"
        />
      </div>
    </div>
  </Container>
</Section>

<script>
  import { initTypewriter } from "@/scripts/typewritter.ts";

  document.addEventListener("DOMContentLoaded", () => {
    const { start, cleanup } = initTypewriter({
      elementId: "about-title",
      word: "About me",
      observe: true,
      speed: 150
    });

    const section = document.querySelector("#about-title");
    if (!section) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            start();
            observer.disconnect();
          }
        });
      },
      {
        threshold: 0.3,
        rootMargin: "0px 0px -100px 0px",
      },
    );

    observer.observe(section);

    return () => {
      observer.disconnect();
      cleanup();
    };
  });
</script>
